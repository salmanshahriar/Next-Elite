# Public app URL (used by SEO, OAuth callbacks).
NEXT_PUBLIC_APP_URL=https://nextelite.salmanshahriar.com

BETTER_AUTH_URL=http://localhost:6767

# Set to "true" to render the "Sign in with Google" button when Google OAuth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Demo mode
# When "true", the login page renders the demo credentials panel and auto-registers the seed accounts in src/_demo(DELETE)/auth/accounts.ts on first sign-in.
# Flip to "false" for prod, or run `npm run demo:remove` to delete all demo code.
NEXT_PUBLIC_DEMO_MODE=true

# Sentry (optional)
# DSNs enable error reporting; the auth token, org and project enable source map uploads at build time.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
