# Public app URL (used by SEO, OAuth callbacks).
NEXT_PUBLIC_APP_URL=https://nextelite.salmanshahriar.com

BETTER_AUTH_URL=http://localhost:6767

# Set to "true" to render the "Sign in with Google" button when Google OAuth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Demo mode
# When "true", the login page renders the demo credentials panel and auto-registers the seed accounts in src/features/auth/demo/accounts.ts on first sign-in.
# Flip to "false" (or delete src/features/auth/demo/) for prod.
NEXT_PUBLIC_DEMO_MODE=true
