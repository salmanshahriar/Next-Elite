# Public app URL (used by SEO, OAuth callbacks). Set to your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:6767

# Better Auth
BETTER_AUTH_URL=http://localhost:6767
# 32+ character secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth (optional)
# Set to "true" to render the "Sign in with Google" button once GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Demo mode
# When "true", the login page renders the demo credentials panel and auto-registers the seed accounts in src/_demo(DELETE)/auth/accounts.ts on first sign-in.
# Flip to "false" for prod, or run `npm run demo:remove` to delete all demo code.
NEXT_PUBLIC_DEMO_MODE=true

# Sentry (optional)
# DSNs enable error reporting; the auth token, org and project enable source map uploads at build time.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
