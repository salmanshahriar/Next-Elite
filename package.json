{
  "name": "next-elite",
  "type": "module",
  "version": "2.3.0",
  "author": "salmanshahriar (https://github.com/salmanshahriar)",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 6767",
    "build": "next build",
    "start": "next start -p 6767",
    "start:standalone": "node .next/standalone/server.js",
    "analyze": "next analyze",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "knip": "knip --config config/knip.json",
    "size": "node scripts/check-bundle-size.mjs",
    "demo:remove": "node scripts/remove-demo.mjs",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run test",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "e2e": "playwright test --config config/playwright.config.ts",
    "playwright:install": "playwright install chromium firefox webkit",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@sentry/nextjs": "11.12.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@vercel/analytics": "2.0.1",
    "better-auth": "1.7.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cobe": "2.0.1",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "nextjs-toploader": "3.9.17",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "uplot": "1.6.32",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "30.1.3",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "kysely": "0.28.17",
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "uuid": "14.0.0",
    "@swc/helpers": "0.5.15"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        2,
        "always",
        200
      ]
    }
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "fsevents": false,
    "lefthook": true
  }
}
