{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,template,default,sitemap,robots,manifest,route}.{ts,tsx}",
    "src/features/i18n/request.ts",
    "src/components/ui/*.tsx"
  ],
  "project": [
    "src/**/*.{js,jsx,ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx}"
  ],
  "ignoreIssues": {
    "src/components/ui/**": ["exports"]
  },
  "ignoreDependencies": ["tw-animate-css", "tailwindcss"],
  "ignoreExportsUsedInFile": true
}
